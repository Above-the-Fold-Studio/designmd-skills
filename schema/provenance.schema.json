{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designskills.dev/schema/provenance.schema.json",
  "title": "Design skill provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["class", "license", "sources", "notes"],
  "properties": {
    "$schema": { "type": "string" },
    "class": {
      "enum": ["original", "synthesized", "adapted", "reference-only"]
    },
    "license": { "type": "string", "minLength": 2 },
    "notes": { "type": "string", "minLength": 10 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "license", "role", "verifiedAt"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "pattern": "^https://" },
          "license": { "type": "string", "minLength": 2 },
          "role": { "enum": ["inspiration", "reference", "adapted"] },
          "commit": { "type": "string", "minLength": 7 },
          "path": { "type": "string", "minLength": 1 },
          "verifiedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
