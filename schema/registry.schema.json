{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designskills.dev/schema/registry.schema.json",
  "title": "Design Skills registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "description", "category", "status", "version", "path",
        "provenance", "testedAgents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 20 },
        "category": { "enum": ["foundation", "workflow"] },
        "status": { "const": "experimental" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": { "type": "string", "pattern": "^skills/[a-z0-9-]+$" },
        "provenance": {
          "enum": ["original", "synthesized", "adapted", "reference-only"]
        },
        "testedAgents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
